      "source": [
        "import torchvision\n",
        "from torchvision import transforms\n",
        "from PIL import Image\n",
        "import pretrained_microscopy_models as pmm\n",
        "import torch.utils.model_zoo as model_zoo\n",
        "\n",
        "micronet = torchvision.models.resnet18(weights=None)\n",
        "micronet_url = pmm.util.get_pretrained_microscopynet_url(\"resnet18\", \"micronet\")\n",
        "micronet.load_state_dict(model_zoo.load_url(micronet_url, map_location=\"cpu\"))\n",
        "micronet.eval()\n",
        "\n",
        "!rm -rf /content/nasa_micronet\n",
        "!git clone -q https://github.com/nasa/pretrained-microscopy-models.git /content/nasa_micronet\n",
        "image_paths = []\n",
        "for suffix in (\"png\", \"jpg\", \"tif\"):\n",
        "    image_paths += glob.glob(\n",
        "        f\"/content/nasa_micronet/benchmark_segmentation_data/**/*.{suffix}\",\n",
        "        recursive=True,\n",
        "    )\n",
        "assert image_paths, \"No repository microscopy image was found\"\n",
        "micronet_image_path = sorted(image_paths)[0]\n",
        "micronet_image = Image.open(micronet_image_path).convert(\"RGB\")\n",
        "\n",
        "micronet_preprocess = transforms.Compose([\n",
        "    transforms.Resize((224, 224)),\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),\n",
        "])\n",
        "micronet_x0 = micronet_preprocess(micronet_image).unsqueeze(0)\n",
        "\n",
        "plt.figure(figsize=(6, 6))\n",
        "plt.imshow(micronet_image)\n",
        "plt.axis(\"off\")\n",
        "plt.title(\"Nominal NASA microscopy image\")\n",
        "plt.show()\n",
        "print(\"Image:\", micronet_image_path)\n",
        "print(\"Released outputs:\", micronet.fc.out_features)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "d2e0a640",
      "metadata": {
        "id": "d2e0a640"
      },
      "source": [
        "## A2. Extract the exact 512-dimensional representation\n",
        "\n",
        "The reconstruction check confirms that applying the released final layer to\n",
        "the extracted representation exactly reproduces the complete ResNet output.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "19e3aedc",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "19e3aedc",
        "outputId": "0e56e13d-e1a0-4014-8b3d-1085d1fd5de9"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Feature shape: (1, 512)\n",
            "Nominal output: 20\n",
            "Runner-up output: 30\n",
            "Nominal margin: 9.427919387817383\n",
            "Reconstruction error: 0.0\n"
          ]
        }
      ],
      "source": [
        "@torch.no_grad()\n",
        "def micronet_features(model, x):\n",
        "    x = model.conv1(x)\n",
        "    x = model.bn1(x)\n",
        "    x = model.relu(x)\n",
        "    x = model.maxpool(x)\n",
        "    x = model.layer1(x)\n",
        "    x = model.layer2(x)\n",
        "    x = model.layer3(x)\n",
        "    x = model.layer4(x)\n",
        "    x = model.avgpool(x)\n",
        "    return torch.flatten(x, 1)\n",
        "\n",
        "with torch.no_grad():\n",
        "    micronet_logits = micronet(micronet_x0)[0]\n",
        "    micronet_z0 = micronet_features(micronet, micronet_x0)\n",
        "    micronet_reconstructed = micronet.fc(micronet_z0)[0]\n",
        "\n",
        "micronet_order = torch.argsort(micronet_logits, descending=True)\n",
        "micronet_pred = int(micronet_order[0])\n",
        "micronet_runner = int(micronet_order[1])\n",
        "micronet_reconstruction_error = float(\n",
        "    (micronet_logits - micronet_reconstructed).abs().max()\n",
        ")\n",
        "\n",
        "print(\"Feature shape:\", tuple(micronet_z0.shape))\n",
        "print(\"Nominal output:\", micronet_pred)\n",
        "print(\"Runner-up output:\", micronet_runner)\n",
        "print(\"Nominal margin:\", float(micronet_logits[micronet_pred] - micronet_logits[micronet_runner]))\n",
        "print(\"Reconstruction error:\", micronet_reconstruction_error)\n",
        "assert micronet_z0.shape == (1, 512)\n",
        "assert micronet_reconstruction_error < 1e-5\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "1296ed51",
      "metadata": {
        "id": "1296ed51"
      },
      "source": [
        "## A3. Build the exact margin and select half the critical radius\n",
        "\n",
        "The exact critical radius for this linear pairwise margin is the nominal\n",
        "margin divided by the (L_1) norm of its weight vector. Verifying at half\n",
        "that radius leaves a positive worst-case margin equal to half the nominal\n",
        "margin.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "470eaa80",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "470eaa80",
        "outputId": "0a317350-5f56-4544-e6fe-a3ca4e0b43cf"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Nominal margin: 9.42791748046875\n",
            "Exact critical epsilon: 0.16645428883779848\n",
            "Verification epsilon: 0.08322714441889924\n",
            "Exact certified lower margin: 4.713958740234375\n"
          ]
        },
        {
          "output_type": "stream",
          "name": "stderr",
          "text": [
            "/tmp/ipykernel_796/898256291.py:15: UserWarning: Converting a tensor with requires_grad=True to a scalar may lead to unexpected behavior.\n",
            "Consider using tensor.detach() first. (Triggered internally at /pytorch/torch/csrc/autograd/generated/python_variable_methods.cpp:836.)\n",
            "  micronet_weight_l1 = float(micronet_margin.weight.abs().sum())\n",
            "/tmp/ipykernel_796/898256291.py:43: DeprecationWarning: You are using the legacy TorchScript-based ONNX export. Starting in PyTorch 2.9, the new torch.export-based ONNX exporter has become the default. Learn more about the new export logic: https://docs.pytorch.org/docs/stable/onnx_export.html. For exporting control flow: https://pytorch.org/tutorials/beginner/onnx/export_control_flow_model_to_onnx_tutorial.html\n",
            "  torch.onnx.export(\n"
          ]
        }
      ],
      "source": [
        "micronet_margin = nn.Linear(512, 1)\n",
        "with torch.no_grad():\n",
        "    micronet_margin.weight.copy_(\n",
        "        micronet.fc.weight[micronet_pred:micronet_pred+1]\n",
        "        - micronet.fc.weight[micronet_runner:micronet_runner+1]\n",
        "    )\n",
        "    micronet_margin.bias.copy_(\n",
        "        micronet.fc.bias[micronet_pred:micronet_pred+1]\n",
        "        - micronet.fc.bias[micronet_runner:micronet_runner+1]\n",
        "    )\n",
        "micronet_margin.eval()\n",
        "\n",
        "with torch.no_grad():\n",
        "    micronet_nominal_margin = float(micronet_margin(micronet_z0))\n",
        "micronet_weight_l1 = float(micronet_margin.weight.abs().sum())\n",
        "micronet_critical_epsilon = micronet_nominal_margin / micronet_weight_l1\n",
        "micronet_epsilon = micronet_critical_epsilon / 2\n",
        "micronet_exact_lower = micronet_nominal_margin - micronet_epsilon * micronet_weight_l1\n",
        "\n",
        "print(\"Nominal margin:\", micronet_nominal_margin)\n",
        "print(\"Exact critical epsilon:\", micronet_critical_epsilon)\n",
        "print(\"Verification epsilon:\", micronet_epsilon)\n",
        "print(\"Exact certified lower margin:\", micronet_exact_lower)\n",
        "assert micronet_exact_lower > 0\n",
        "\n",
        "np.save(\"/content/micronet_feature_z0.npy\", micronet_z0.numpy().astype(np.float32))\n",
        "np.save(\"/content/micronet_feature_weight.npy\", micronet_margin.weight.detach().numpy().astype(np.float32))\n",
        "np.save(\"/content/micronet_feature_bias.npy\", micronet_margin.bias.detach().numpy().astype(np.float32))\n",
        "micronet_meta = {\n",
        "    \"model\": \"NASA MicroNet-pretrained ResNet-18 released feature head\",\n",
        "    \"image\": micronet_image_path,\n",
        "    \"predicted_output\": micronet_pred,\n",
        "    \"runner_up_output\": micronet_runner,\n",
        "    \"feature_dimension\": 512,\n",
        "    \"nominal_margin\": micronet_nominal_margin,\n",
        "    \"critical_epsilon\": micronet_critical_epsilon,\n",
        "    \"verification_epsilon\": micronet_epsilon,\n",
        "    \"exact_lower_margin\": micronet_exact_lower,\n",
        "    \"scope\": \"pairwise feature-level robustness of the exact final linear layer\",\n",
        "}\n",
        "json.dump(micronet_meta, open(\"/content/micronet_feature_meta.json\", \"w\"), indent=2)\n",
        "\n",
        "torch.onnx.export(\n",
        "    micronet_margin, micronet_z0, \"/content/micronet_feature_margin.onnx\",\n",
        "    input_names=[\"microscopy_features\"], output_names=[\"pairwise_margin\"],\n",
        "    opset_version=17, do_constant_folding=True, dynamo=False,\n",
        ")\n",
        "onnx.checker.check_model(onnx.load(\"/content/micronet_feature_margin.onnx\"))\n"
