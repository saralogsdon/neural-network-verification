      "source": [
        "%%writefile /content/run_micronet_feature_marabou.py\n",
        "import json, numpy as np\n",
        "from maraboupy import Marabou\n",
        "\n",
        "z0 = np.load(\"/content/micronet_feature_z0.npy\").reshape(-1)\n",
        "meta = json.load(open(\"/content/micronet_feature_meta.json\"))\n",
        "eps = float(meta[\"verification_epsilon\"])\n",
        "net = Marabou.read_onnx(\"/content/micronet_feature_margin.onnx\")\n",
        "iv = net.inputVars[0].flatten(); ov = net.outputVars[0].flatten()\n",
        "for var, value in zip(iv, z0):\n",
        "    net.setLowerBound(int(var), float(value-eps))\n",
        "    net.setUpperBound(int(var), float(value+eps))\n",
        "net.addInequality([int(ov[0])], [1.0], 0.0)\n",
        "code, values, stats = net.solve(options=Marabou.createOptions(timeoutInSeconds=60, verbosity=0))\n",
        "status = str(code).lower()\n",
        "record = {\"demo\":\"NASA MicroNet feature head\", \"tool\":\"Marabou\",\n",
        "          \"status\":status, \"verified\":status==\"unsat\", \"epsilon\":eps,\n",
        "          \"query\":\"predicted-minus-runner-up margin <= 0\"}\n",
        "print(\"\\nMICRONET FEATURE — MARABOU\")\n",
        "print(json.dumps(record, indent=2))\n",
        "json.dump(record, open(\"/content/all_demo_results/micronet_marabou.json\", \"w\"), indent=2)\n"
