      "source": [
        "from google.colab import files\n",
        "import shutil, zipfile\n",
        "\n",
        "assets=[\n",
        "    \"micronet_feature_meta.json\",\"micronet_feature_margin.onnx\",\"micronet_feature_z0.npy\",\n",
        "    \"nasa_text_meta.json\",\"nasa_text_margins.onnx\",\"nasa_text_h0.npy\",\n",
        "    \"airfoil_reduced.onnx\",\"gibs_meta.json\",\"gibs_margin.onnx\",\"gibs_x0.npy\",\n",
        "    \"gibs_nominal.png\",\"gibs_controlled_anomaly.png\",\n",
        "]\n",
        "copied=[]; missing_assets=[]\n",
        "for name in assets:\n",
        "    source=Path(\"/content\")/name\n",
        "    if source.exists():\n",
        "        shutil.copy2(source,RESULTS/name); copied.append(name)\n",
        "    else:\n",
        "        missing_assets.append(name)\n",
        "json.dump({\"copied\":copied,\"missing\":missing_assets},open(RESULTS/\"asset_manifest.json\",\"w\"),indent=2)\n",
        "zip_path=Path(\"/content/all_verification_demo_results.zip\")\n",
        "with zipfile.ZipFile(zip_path,\"w\",compression=zipfile.ZIP_DEFLATED) as archive:\n",
        "    for path in sorted(RESULTS.rglob(\"*\")):\n",
        "        if path.is_file(): archive.write(path,path.relative_to(RESULTS.parent))\n",
        "print(\"Created:\",zip_path)\n",
        "print(\"Evidence records missing:\",missing)\n",
        "print(\"Optional assets missing:\",missing_assets)\n",
        "files.download(str(zip_path))\n"
      ]
    },
