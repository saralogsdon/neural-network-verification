        "## C3. α,β-CROWN proof against all four alternatives\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "60c7b895",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "60c7b895",
        "outputId": "37009188-86d0-43d4-c852-12e953dcc967"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Writing /content/run_nasa_text_abcrown_all.py\n"
          ]
        }
      ],
      "source": [
        "%%writefile /content/run_nasa_text_abcrown_all.py\n",
        "import json, numpy as np, torch, torch.nn as nn\n",
        "from abcrown import ABCrownSolver, IOConstraints, ConfigBuilder, input_vars, output_vars\n",
        "\n",
        "h0=torch.from_numpy(np.load(\"/content/nasa_text_h0.npy\")).squeeze(0)\n",
        "W=torch.from_numpy(np.load(\"/content/nasa_text_weights.npy\")); b=torch.from_numpy(np.load(\"/content/nasa_text_biases.npy\"))\n",
        "meta=json.load(open(\"/content/nasa_text_meta.json\")); eps=float(meta[\"verification_epsilon\"])\n",
        "head=nn.Linear(768,4)\n",
        "with torch.no_grad(): head.weight.copy_(W); head.bias.copy_(b)\n",
        "head.eval(); x=input_vars((768,)); y=output_vars(4)\n",
        "out=y[0]>0\n",
        "for i in range(1,4): out=out&(y[i]>0)\n",
        "cons=IOConstraints(input_vars=x,output_vars=y,\n",
        "    input_constraint=(x>=h0-eps)&(x<=h0+eps),output_constraint=out)\n",
        "cfg=(ConfigBuilder.from_defaults().set(\"general/device\",\"cpu\")\n",
        "     .set(\"attack/pgd_order\",\"skip\").set(\"bab/timeout\",60))\n",
        "result=ABCrownSolver(head,x,y,config=cfg).verify(constraints=cons)\n",
        "record={\"demo\":\"Official NASA division classifier\",\"tool\":\"alpha-beta-CROWN\",\n",
        "    \"status\":str(result.status),\"verified\":bool(result.success),\"epsilon\":eps,\n",
        "    \"predicted_division\":meta[\"predicted_division\"],\"competitors_checked\":4,\n",
        "    \"minimum_lower_margin\":meta[\"minimum_lower_margin\"]}\n",
        "print(\"\\nNASA TEXT — alpha-beta-CROWN\"); print(json.dumps(record,indent=2))\n",
        "json.dump(record,open(\"/content/all_demo_results/text_abcrown.json\",\"w\"),indent=2)\n"
      ]
    },
