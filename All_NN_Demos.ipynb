      "source": [
        "from transformers import AutoModelForSequenceClassification, AutoTokenizer\n",
        "\n",
        "TEXT_MODEL_NAME = \"nasa-impact/division-classifier\"\n",
        "TEXT = (\n",
        "    \"NASA Earth-observing satellites measure changes in oceans, land, ice, \"\n",
        "    \"and the atmosphere to improve understanding of our planet's climate system.\"\n",
        ")\n",
        "text_tokenizer = AutoTokenizer.from_pretrained(TEXT_MODEL_NAME)\n",
        "text_model = AutoModelForSequenceClassification.from_pretrained(TEXT_MODEL_NAME).eval()\n",
        "text_inputs = text_tokenizer(TEXT, return_tensors=\"pt\", truncation=True, max_length=256)\n",
        "\n",
        "with torch.no_grad():\n",
        "    text_logits = text_model(**text_inputs).logits[0]\n",
        "    text_encoded = text_model.roberta(**text_inputs).last_hidden_state\n",
        "    text_h0 = torch.tanh(text_model.classifier.dense(text_encoded[:, 0, :]))\n",
        "    text_reconstructed = text_model.classifier.out_proj(text_h0)[0]\n",
        "\n",
        "text_labels = {int(k): v for k, v in text_model.config.id2label.items()}\n",
        "text_order = torch.argsort(text_logits, descending=True)\n",
        "text_pred = int(text_order[0]); text_runner = int(text_order[1])\n",
        "text_error = float((text_logits-text_reconstructed).abs().max())\n",
        "print(\"Text:\", TEXT)\n",
        "print(\"Prediction:\", text_labels[text_pred])\n",
        "print(\"Runner-up:\", text_labels[text_runner])\n",
        "print(\"Feature shape:\", tuple(text_h0.shape))\n",
        "print(\"Reconstruction error:\", text_error)\n",
        "assert text_h0.shape == (1, 768) and text_error < 1e-6\n",
        "\n",
        "display(pd.DataFrame({\n",
        "    \"output\": range(5), \"NASA division\":[text_labels[i] for i in range(5)],\n",
        "    \"logit\":text_logits.numpy(),\n",
        "}).sort_values(\"logit\", ascending=False).reset_index(drop=True))\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "5443c17d",
      "metadata": {
        "id": "5443c17d"
      },
