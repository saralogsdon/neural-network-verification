        "%%writefile /content/run_nasa_text_marabou_all.py\n",
        "import json,numpy as np\n",
        "from maraboupy import Marabou\n",
        "h0=np.load(\"/content/nasa_text_h0.npy\").reshape(-1)\n",
        "meta=json.load(open(\"/content/nasa_text_meta.json\")); eps=float(meta[\"verification_epsilon\"])\n",
        "queries=[]\n",
        "for i,division in enumerate(meta[\"competitor_divisions\"]):\n",
        "    net=Marabou.read_onnx(\"/content/nasa_text_margins.onnx\")\n",
        "    iv=net.inputVars[0].flatten(); ov=net.outputVars[0].flatten()\n",
        "    for var,value in zip(iv,h0):\n",
        "        net.setLowerBound(int(var),float(value-eps)); net.setUpperBound(int(var),float(value+eps))\n",
        "    net.addInequality([int(ov[i])],[1.0],0.0)\n",
        "    code,vals,stats=net.solve(options=Marabou.createOptions(timeoutInSeconds=60,verbosity=0))\n",
        "    status=str(code).lower(); queries.append({\"competitor\":division,\"status\":status,\"verified\":status==\"unsat\"})\n",
        "    print(division, status)\n",
        "record={\"demo\":\"Official NASA division classifier\",\"tool\":\"Marabou\",\n",
        "    \"predicted_division\":meta[\"predicted_division\"],\"epsilon\":eps,\n",
        "    \"verified\":all(q[\"verified\"] for q in queries),\"queries\":queries}\n",
        "print(\"\\nNASA TEXT — MARABOU\"); print(json.dumps(record,indent=2))\n",
        "json.dump(record,open(\"/content/all_demo_results/text_marabou.json\",\"w\"),indent=2)\n"
      ]
