        "text_competitors = [j for j in range(5) if j != text_pred]\n",
        "text_projection = text_model.classifier.out_proj\n",
        "text_weights = torch.stack([\n",
        "    text_projection.weight[text_pred]-text_projection.weight[j]\n",
        "    for j in text_competitors\n",
        "]).detach()\n",
        "text_biases = torch.stack([\n",
        "    text_projection.bias[text_pred]-text_projection.bias[j]\n",
        "    for j in text_competitors\n",
        "]).detach()\n",
        "text_margin_head = nn.Linear(768, 4)\n",
        "with torch.no_grad():\n",
        "    text_margin_head.weight.copy_(text_weights)\n",
        "    text_margin_head.bias.copy_(text_biases)\n",
        "    text_margins = text_margin_head(text_h0)[0]\n",
        "\n",
        "text_l1 = text_weights.abs().sum(1)\n",
        "text_critical_by_competitor = text_margins/text_l1\n",
        "text_critical_epsilon = float(text_critical_by_competitor.min())\n",
        "text_epsilon = text_critical_epsilon/2\n",
        "text_lower = text_margins-text_epsilon*text_l1\n",
        "\n",
        "display(pd.DataFrame({\n",
        "    \"competitor\":[text_labels[j] for j in text_competitors],\n",
        "    \"nominal margin\":text_margins.numpy(),\n",
        "    \"critical epsilon\":text_critical_by_competitor.numpy(),\n",
        "    \"certified lower margin\":text_lower.numpy(),\n",
        "}))\n",
        "print(\"Verification epsilon:\", text_epsilon)\n",
        "print(\"Minimum certified lower margin:\", float(text_lower.min()))\n",
        "assert bool(torch.all(text_lower>0))\n",
