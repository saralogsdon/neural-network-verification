      "source": [
        "from pathlib import Path\n",
        "import json, pandas as pd\n",
        "\n",
        "RESULTS=Path(\"/content/all_demo_results\")\n",
        "RESULTS.mkdir(parents=True,exist_ok=True)\n",
        "\n",
        "def load_record(filename):\n",
        "    path=RESULTS/filename\n",
        "    if not path.exists():\n",
        "        return None\n",
        "    try:\n",
        "        return json.load(open(path))\n",
        "    except Exception as exc:\n",
        "        print(f\"Could not read {filename}: {exc}\")\n",
        "        return None\n",
        "\n",
        "records={\n",
        "    \"micronet_a\":load_record(\"micronet_abcrown.json\"),\n",
        "    \"micronet_m\":load_record(\"micronet_marabou.json\"),\n",
        "    \"airfoil\":load_record(\"airfoil_both.json\"),\n",
        "    \"text_a\":load_record(\"text_abcrown.json\"),\n",
        "    \"text_m\":load_record(\"text_marabou.json\"),\n",
        "    \"gibs\":load_record(\"gibs_both.json\"),\n",
        "}\n",
        "micronet_a=records[\"micronet_a\"]; micronet_m=records[\"micronet_m\"]\n",
        "airfoil=records[\"airfoil\"]\n",
        "text_a=records[\"text_a\"]; text_m=records[\"text_m\"]\n",
        "gibs=records[\"gibs\"]\n",
        "\n",
        "def field(record,key):\n",
        "    return record.get(key) if record is not None else None\n",
        "\n",
        "def verdict(record,verified_key,success_text,fallback_key=None):\n",
        "    if record is None:\n",
        "        return \"NOT RUN\"\n",
        "    if bool(record.get(verified_key,False)):\n",
        "        return success_text\n",
        "    return str(record.get(fallback_key,\"INCONCLUSIVE\")) if fallback_key else \"INCONCLUSIVE\"\n",
        "\n",
        "main_results=pd.DataFrame([\n",
        "    {\"Demo\":\"NASA MicroNet feature head\",\"Scope\":\"pairwise / 512 features\",\n",
        "     \"epsilon\":field(micronet_a,\"epsilon\"),\n",
        "     \"alpha-beta-CROWN\":verdict(micronet_a,\"verified\",\"VERIFIED\",\"status\"),\n",
        "     \"Marabou\":verdict(micronet_m,\"verified\",\"UNSAT — VERIFIED\",\"status\")},\n",
        "    {\"Demo\":\"NASA Airfoil Learning MLP\",\"Scope\":\"fixed geometry / 3 operating inputs\",\n",
        "     \"epsilon\":field(airfoil,\"input_delta\"),\n",
        "     \"alpha-beta-CROWN\":verdict(airfoil,\"abcrown_verified\",\"VERIFIED\",\"abcrown_status\"),\n",
        "     \"Marabou\":verdict(airfoil,\"marabou_verified\",\"2× UNSAT — VERIFIED\")},\n",
        "    {\"Demo\":\"Official NASA division classifier\",\"Scope\":\"all competitors / 768 features\",\n",
        "     \"epsilon\":field(text_a,\"epsilon\"),\n",
        "     \"alpha-beta-CROWN\":verdict(text_a,\"verified\",\"VERIFIED\",\"status\"),\n",
        "     \"Marabou\":verdict(text_m,\"verified\",\"4× UNSAT — VERIFIED\")},\n",
        "    {\"Demo\":\"NASA GIBS anomaly architecture\",\"Scope\":\"complete MLP / 256 image features\",\n",
        "     \"epsilon\":field(gibs,\"epsilon\"),\n",
        "     \"alpha-beta-CROWN\":verdict(gibs,\"abcrown_verified\",\"VERIFIED\",\"abcrown_status\"),\n",
        "     \"Marabou\":verdict(gibs,\"marabou_verified\",\"UNSAT — VERIFIED\",\"marabou_status\")},\n",
        "])\n",
        "\n",
        "missing=[name for name,record in records.items() if record is None]\n",
        "manifest={\"available\":[name for name,record in records.items() if record is not None],\"missing\":missing}\n",
        "json.dump(manifest,open(RESULTS/\"evidence_manifest.json\",\"w\"),indent=2)\n",
        "main_results.to_csv(RESULTS/\"all_demo_results.csv\",index=False)\n",
        "print(\"ALL DEMO RESULTS\")\n",
        "display(main_results)\n",
        "if missing:\n",
        "    print(\"\\nThe package will be created, but these result records are missing:\")\n",
        "    for name in missing: print(\" -\",name)\n",
        "    print(\"Rerun the corresponding verifier section, then rerun these final cells.\")\n",
        "else:\n",
        "    print(\"\\nAll expected result records are present.\")\n"
      ]
    },
