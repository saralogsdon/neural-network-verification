      "source": [
        "## D3. Verify the same complete classifier with both tools\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "4ef3bcc1",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "4ef3bcc1",
        "outputId": "7ba2f84a-01b8-4a22-9173-53d5c92de7b3"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Writing /content/run_gibs_both.py\n"
          ]
        }
      ],
      "source": [
        "%%writefile /content/run_gibs_both.py\n",
        "import json,numpy as np,torch,torch.nn as nn\n",
        "from abcrown import ABCrownSolver,IOConstraints,ConfigBuilder,input_vars,output_vars\n",
        "from maraboupy import Marabou\n",
        "\n",
        "p=np.load(\"/content/gibs_parameters.npz\"); x0=torch.from_numpy(np.load(\"/content/gibs_x0.npy\")).squeeze(0)\n",
        "meta=json.load(open(\"/content/gibs_meta.json\")); eps=float(meta[\"verification_epsilon\"])\n",
        "model=nn.Sequential(nn.Linear(256,100),nn.ReLU(),nn.Linear(100,1))\n",
        "with torch.no_grad():\n",
        "    model[0].weight.copy_(torch.from_numpy(p[\"w0\"])); model[0].bias.copy_(torch.from_numpy(p[\"b0\"]))\n",
        "    model[2].weight.copy_(torch.from_numpy(p[\"w1\"])); model[2].bias.copy_(torch.from_numpy(p[\"b1\"]))\n",
        "model.eval(); x=input_vars((256,)); y=output_vars(1)\n",
        "cons=IOConstraints(input_vars=x,output_vars=y,input_constraint=(x>=x0-eps)&(x<=x0+eps),output_constraint=y[0]>0)\n",
        "cfg=(ConfigBuilder.from_defaults().set(\"general/device\",\"cpu\").set(\"attack/pgd_order\",\"skip\").set(\"bab/timeout\",60))\n",
        "ar=ABCrownSolver(model,x,y,config=cfg).verify(constraints=cons)\n",
        "\n",
        "net=Marabou.read_onnx(\"/content/gibs_margin.onnx\"); iv=net.inputVars[0].flatten(); ov=net.outputVars[0].flatten()\n",
        "for var,value in zip(iv,x0.numpy()):\n",
        "    net.setLowerBound(int(var),float(value-eps)); net.setUpperBound(int(var),float(value+eps))\n",
        "net.addInequality([int(ov[0])],[1.0],0.0)\n",
        "mc,vals,stats=net.solve(options=Marabou.createOptions(timeoutInSeconds=60,verbosity=0)); status=str(mc).lower()\n",
        "record={\"demo\":\"NASA GIBS anomaly architecture\",\"tool_scope\":\"complete 256-feature ReLU classifier\",\n",
        "    \"epsilon\":eps,\"abcrown_status\":str(ar.status),\"abcrown_verified\":bool(ar.success),\n",
        "    \"marabou_status\":status,\"marabou_verified\":status==\"unsat\",\"nominal_margin\":meta[\"nominal_margin\"],\n",
        "    \"exact_lower_margin\":meta[\"exact_lower_margin\"],\"selected_date\":meta[\"selected_date\"]}\n",
        "print(\"\\nNASA GIBS ANOMALY CLASSIFIER — BOTH VERIFIERS\"); print(json.dumps(record,indent=2))\n",
        "json.dump(record,open(\"/content/all_demo_results/gibs_both.json\",\"w\"),indent=2)\n"
      ]
    },
