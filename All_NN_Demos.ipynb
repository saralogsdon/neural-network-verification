      "source": [
        "%%writefile /content/run_micronet_feature_abcrown.py\n",
        "import json, numpy as np, torch, torch.nn as nn\n",
        "from abcrown import ABCrownSolver, IOConstraints, ConfigBuilder, input_vars, output_vars\n",
        "\n",
        "z0 = torch.from_numpy(np.load(\"/content/micronet_feature_z0.npy\")).squeeze(0)\n",
        "weight = torch.from_numpy(np.load(\"/content/micronet_feature_weight.npy\"))\n",
        "bias = torch.from_numpy(np.load(\"/content/micronet_feature_bias.npy\"))\n",
        "meta = json.load(open(\"/content/micronet_feature_meta.json\"))\n",
        "eps = float(meta[\"verification_epsilon\"])\n",
        "head = nn.Linear(512, 1)\n",
        "with torch.no_grad():\n",
        "    head.weight.copy_(weight); head.bias.copy_(bias)\n",
        "head.eval()\n",
        "\n",
        "x = input_vars((512,)); y = output_vars(1)\n",
        "constraints = IOConstraints(\n",
        "    input_vars=x, output_vars=y,\n",
        "    input_constraint=(x >= z0-eps) & (x <= z0+eps),\n",
        "    output_constraint=y[0] > 0,\n",
        ")\n",
        "config = (ConfigBuilder.from_defaults().set(\"general/device\", \"cpu\")\n",
        "          .set(\"attack/pgd_order\", \"skip\").set(\"bab/timeout\", 60))\n",
        "result = ABCrownSolver(head, x, y, config=config).verify(constraints=constraints)\n",
        "record = {\"demo\":\"NASA MicroNet feature head\", \"tool\":\"alpha-beta-CROWN\",\n",
        "          \"status\":str(result.status), \"verified\":bool(result.success),\n",
        "          \"epsilon\":eps, \"predicted_output\":meta[\"predicted_output\"],\n",
