        "sentences=[]\n",
        "if micronet_a and micronet_m and micronet_a.get(\"verified\") and micronet_m.get(\"verified\"):\n",
        "    sentences.append(f\"NASA MicroNet: both tools verified that output {micronet_a['predicted_output']} remains above output {micronet_a['competitor_output']} for every ±{micronet_a['epsilon']:.6f} perturbation across all 512 final-layer input features.\")\n",
        "else:\n",
        "    sentences.append(\"NASA MicroNet: final matching evidence is missing or inconclusive.\")\n",
        "if airfoil and airfoil.get(\"abcrown_verified\") and airfoil.get(\"marabou_verified\"):\n",
        "    sentences.append(f\"NASA Airfoil Learning: with geometry fixed, both tools verified that every ±{airfoil['input_delta']:.6f} change in normalized angle of attack, Reynolds number, and Ncrit keeps predicted {airfoil['output']} within ±{airfoil['output_tolerance']:.6f} of its nominal value.\")\n",
        "else:\n",
        "    sentences.append(\"NASA Airfoil Learning: final matching evidence is missing or inconclusive.\")\n",
        "if text_a and text_m and text_a.get(\"verified\") and text_m.get(\"verified\"):\n",
        "    sentences.append(f\"Official NASA text classifier: both tools verified that the {text_a['predicted_division']} decision remains above all four alternative divisions for every ±{text_a['epsilon']:.6f} perturbation across all 768 final-layer input features.\")\n",
        "else:\n",
        "    sentences.append(\"Official NASA text classifier: final matching evidence is missing or inconclusive.\")\n",
        "if gibs and gibs.get(\"abcrown_verified\") and gibs.get(\"marabou_verified\"):\n",
        "    sentences.append(f\"NASA GIBS: both tools verified the complete 256-feature ReLU anomaly classifier for every ±{gibs['epsilon']:.6f} feature perturbation around a normal satellite image.\")\n",
        "else:\n",
        "    sentences.append(\"NASA GIBS: final matching evidence is missing or inconclusive.\")\n",
        "sentences.append(\"MicroNet and the text result use official-checkpoint feature heads; Airfoil and GIBS use official NASA architectures retrained in this notebook.\")\n",
        "conclusion=\" \".join(sentences)\n",
        "print(\"PRESENTATION-READY CONCLUSION\\n\")\n",
        "print(conclusion)\n",
        "(RESULTS/\"combined_conclusion.txt\").write_text(conclusion)\n"
      ]
    },
