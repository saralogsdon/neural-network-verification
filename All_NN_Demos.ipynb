      "source": [
        "## B3. Verify the identical three-input property with both tools\n",
        "\n",
        "α,β-CROWN proves the desired two-sided output constraint directly. Marabou\n",
        "checks the two possible violations separately: `Cl <= lower limit` and\n",
        "`Cl >= upper limit`. Both Marabou queries must be `unsat`. The published\n",
        "network uses clipped ReLU written as `relu(z)-relu(z-6)`, whose scalar\n",
        "broadcast is not accepted by Marabou's ONNX parser. The script therefore\n",
        "proves that every clipped-ReLU phase is stable throughout this small input\n",
        "box and exports the resulting exact affine network to Marabou. This is a\n",
        "sound reduction of the same trained network and property, not sampling.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "2637e215",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "2637e215",
        "outputId": "663098fe-3021-483a-b65f-1ce69e9cd32a"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Writing /content/run_airfoil_both.py\n"
          ]
        }
      ],
      "source": [
        "%%writefile /content/run_airfoil_both.py\n",
        "import json, numpy as np, torch, torch.nn as nn\n",
        "from abcrown import ABCrownSolver,IOConstraints,ConfigBuilder,input_vars,output_vars\n",
        "from maraboupy import Marabou\n",
        "\n",
        "class AirfoilMLP(nn.Module):\n",
        "    def __init__(self,d):\n",
        "        super().__init__(); dims=[d,64,64,64,64,4]\n",
        "        self.layers=nn.ModuleList([nn.Linear(dims[i],dims[i+1]) for i in range(len(dims)-1)])\n",
        "    def forward(self,x):\n",
        "        for layer in self.layers[:-1]:\n",
        "            z=layer(x); x=torch.relu(z)-torch.relu(z-6.0)\n",
        "        return self.layers[-1](x)\n",
        "\n",
        "delta=0.001; output_index=0; tolerance=0.01; names=[\"Cl\",\"Cd\",\"Cdp\",\"Cm\"]\n",
        "cp=torch.load(\"/content/airfoil_demo.pt\",map_location=\"cpu\",weights_only=False)\n",
        "full=AirfoilMLP(cp[\"input_dimension\"]); full.load_state_dict(cp[\"state_dict\"]); full.eval()\n",
        "base=cp[\"sample_x\"].float().flatten(); fixed=base[:-3]; operating=base[-3:]\n",
        "reduced=AirfoilMLP(3)\n",
        "with torch.no_grad():\n",
        "    reduced.layers[0].weight.copy_(full.layers[0].weight[:,-3:])\n",
        "    reduced.layers[0].bias.copy_(full.layers[0].bias+full.layers[0].weight[:,:-3]@fixed)\n",
        "    for r,f in zip(reduced.layers[1:],full.layers[1:]): r.weight.copy_(f.weight); r.bias.copy_(f.bias)\n",
        "    full_y=full(base.unsqueeze(0))[0]; reduced_y=reduced(operating.unsqueeze(0))[0]\n",
        "equivalence=float((full_y-reduced_y).abs().max()); assert equivalence<1e-5\n",
        "lower=torch.clamp(operating-delta,0,1); upper=torch.clamp(operating+delta,0,1)\n",
        "nominal=float(reduced_y[output_index]); required_lower=nominal-tolerance; required_upper=nominal+tolerance\n",
        "\n",
        "random_x=lower+torch.rand(10_000,3)*(upper-lower)\n",
        "with torch.no_grad(): random_y=reduced(random_x)[:,output_index]\n",
        "print(\"NASA AIRFOIL PROPERTY\")\n",
        "print(\"Fixed geometry; variable [angle of attack, Reynolds number, Ncrit]\")\n",
        "print(\"Nominal normalized inputs:\",operating.tolist())\n",
        "print(\"Input delta:\",delta,\"output:\",names[output_index],\"tolerance:\",tolerance)\n",
        "print(\"Required output interval:\",[required_lower,required_upper])\n",
        "print(\"10,000 sampled range:\",[float(random_y.min()),float(random_y.max())])\n",
        "print(\"Reduction equivalence error:\",equivalence)\n",
        "\n",
        "# Soundly reduce the clipped-ReLU network to its exact affine form on this box.\n",
        "# Each neuron must remain below 0, between 0 and 6, or above 6 everywhere.\n",
        "box_center=(lower+upper)/2; box_radius=(upper-lower)/2\n",
        "A=torch.eye(3); c=torch.zeros(3); phase_counts=[]\n",
        "for layer_index,layer in enumerate(reduced.layers[:-1],start=1):\n",
        "    Az=layer.weight.detach()@A\n",
        "    cz=layer.weight.detach()@c+layer.bias.detach()\n",
        "    center=Az@box_center+cz; radius=Az.abs()@box_radius\n",
        "    Lz=center-radius; Uz=center+radius\n",
        "    low=Uz<=0; linear=(Lz>=0)&(Uz<=6); high=Lz>=6\n",
        "    stable=low|linear|high\n",
        "    if not bool(stable.all()):\n",
        "        bad=int((~stable).sum())\n",
        "        raise RuntimeError(f\"Layer {layer_index} has {bad} phase-unstable neurons; reduce delta.\")\n",
        "    phase_counts.append({\"layer\":layer_index,\"below_zero\":int(low.sum()),\n",
        "        \"linear\":int(linear.sum()),\"above_six\":int(high.sum())})\n",
        "    A_next=torch.zeros_like(Az); c_next=torch.zeros_like(cz)\n",
        "    A_next[linear]=Az[linear]; c_next[linear]=cz[linear]; c_next[high]=6.0\n",
        "    A,c=A_next,c_next\n",
        "final_layer=reduced.layers[-1]\n",
        "Aout=final_layer.weight.detach()@A\n",
        "bout=final_layer.weight.detach()@c+final_layer.bias.detach()\n",
        "analytic_center=Aout@box_center+bout; analytic_radius=Aout.abs()@box_radius\n",
        "analytic_lower=analytic_center-analytic_radius; analytic_upper=analytic_center+analytic_radius\n",
        "\n",
        "class AirfoilAffine(nn.Module):\n",
        "    def __init__(self,A,b):\n",
        "        super().__init__(); self.linear=nn.Linear(3,4)\n",
        "        with torch.no_grad(): self.linear.weight.copy_(A); self.linear.bias.copy_(b)\n",
        "    def forward(self,x): return self.linear(x)\n",
        "affine=AirfoilAffine(Aout,bout).eval()\n",
        "with torch.no_grad(): phase_reduction_error=float((affine(operating.unsqueeze(0))[0]-reduced_y).abs().max())\n",
        "assert phase_reduction_error<1e-5\n",
        "print(\"Stable clipped-ReLU phases:\",phase_counts)\n",
        "print(\"Exact analytic Cl interval:\",[float(analytic_lower[0]),float(analytic_upper[0])])\n",
        "print(\"Phase-reduction error at nominal input:\",phase_reduction_error)\n",
        "assert float(analytic_lower[0])>required_lower and float(analytic_upper[0])<required_upper\n",
        "\n",
        "torch.onnx.export(affine,operating.unsqueeze(0),\"/content/airfoil_reduced.onnx\",\n",
        "    input_names=[\"operating_conditions\"],output_names=[\"aerodynamic_coefficients\"],\n",
        "    opset_version=17,do_constant_folding=True,dynamo=False)\n",
        "\n",
        "x=input_vars((3,)); y=output_vars(4)\n",
        "cons=IOConstraints(input_vars=x,output_vars=y,input_constraint=(x>=lower)&(x<=upper),\n",
        "    output_constraint=(y[output_index]>required_lower)&(y[output_index]<required_upper))\n",
        "cfg=(ConfigBuilder.from_defaults().set(\"general/device\",\"cpu\").set(\"attack/pgd_order\",\"skip\")\n",
        "     .set(\"general/complete_verifier\",\"bab\").set(\"bab/branching/input_split/enable\",True)\n",
        "     .set(\"bab/branching/method\",\"sb\").set(\"bab/timeout\",120).set(\"solver/batch_size\",256))\n",
        "ar=ABCrownSolver(reduced,x,y,config=cfg).verify(constraints=cons)\n",
        "\n",
        "def marabou_query(side):\n",
        "    net=Marabou.read_onnx(\"/content/airfoil_reduced.onnx\")\n",
        "    iv=net.inputVars[0].flatten(); ov=net.outputVars[0].flatten()\n",
        "    for var,lo,hi in zip(iv,lower.numpy(),upper.numpy()):\n",
        "        net.setLowerBound(int(var),float(lo)); net.setUpperBound(int(var),float(hi))\n",
        "    if side==\"lower\": net.addInequality([int(ov[output_index])],[1.0],float(required_lower))\n",
        "    else: net.addInequality([int(ov[output_index])],[-1.0],float(-required_upper))\n",
        "    code,vals,stats=net.solve(options=Marabou.createOptions(timeoutInSeconds=120,verbosity=0))\n",
        "    return str(code).lower()\n",
        "lower_status=marabou_query(\"lower\"); upper_status=marabou_query(\"upper\")\n",
        "record={\"demo\":\"NASA Airfoil Learning MLP\",\"scope\":\"fixed geometry; three normalized operating inputs\",\n",
        "    \"output\":names[output_index],\"input_delta\":delta,\"output_tolerance\":tolerance,\n",
        "    \"nominal_output\":nominal,\"required_lower\":required_lower,\"required_upper\":required_upper,\n",
        "    \"equivalence_error\":equivalence,\"phase_reduction_error\":phase_reduction_error,\n",
        "    \"stable_activation_phases\":True,\"phase_counts\":phase_counts,\n",
        "    \"analytic_lower\":float(analytic_lower[output_index]),\"analytic_upper\":float(analytic_upper[output_index]),\n",
        "    \"abcrown_status\":str(ar.status),\"abcrown_verified\":bool(ar.success),\n",
        "    \"marabou_lower_violation\":lower_status,\"marabou_upper_violation\":upper_status,\n",
        "    \"marabou_verified\":lower_status==\"unsat\" and upper_status==\"unsat\"}\n",
        "print(\"\\nNASA AIRFOIL — BOTH VERIFIERS\"); print(json.dumps(record,indent=2))\n",
        "json.dump(record,open(\"/content/all_demo_results/airfoil_both.json\",\"w\"),indent=2)\n"
      ]
    },
